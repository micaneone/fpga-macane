# ============================================================
#  M1 集成工程引脚约束（康芯 HX4S20C / EG4S20BG256）
#
#  顶层端口（top_m2.v）：
#    clk  rst_n  key1  key2  key3  sw1  sw2  sw3  sw4
#    sd_ncs sd_dclk sd_mosi sd_miso
#    led[3:0]  seg_sel[5:0]  seg_data[7:0]  uart_tx
#    HDMI_CLK_P HDMI_D0_P HDMI_D1_P HDMI_D2_P HDMI_DDC_SCL HDMI_DDC_SDA
#
#  ★ 顶层端口必须【全部】有约束，否则 TD 拒绝生成 .bit：
#      BIT-8123 ERROR: Bitgen is prohibitted as there is(are)
#                      unconstrained io(s) in design.
#    确实不接外设的信号可以写 LOCATION = virtualIO;
#
#  来源：M0 测试工程的 bwtest_pin.adc（时钟/复位/按键/LED/数码管/串口/HDMI）
#        + A 轨工程那份的 SD 四根脚
#
#  ★ 引脚是复用的：M16/K16 既是 PS/2 又是音频 ADC 侧；DA 通道与矩阵键盘抢脚。
#    本工程只用了 时钟/按键/LED/数码管/串口/SD/HDMI，不冲突。
# ============================================================

# ---------- 时钟与复位 ----------
set_pin_assignment	{ clk }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ rst_n }	{ LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- 按键（低有效，内部上拉）----------
#   板子丝印 / 引脚（照《HX4S20 开发板手册》）：KEY1=A2  KEY2=B2  KEY3=B1  KEY4=C1
#   A2 在本工程里当硬复位 rst_n，所以只剩三个可用：
#   key1(B2) = 读地址补偿旋钮   key2(C1) = 软复位重来   key3(B1) = 装载 / 换下一张
set_pin_assignment	{ key1 }	{ LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ key2 }	{ LOCATION = C1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ key3 }	{ LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- 开关1 / 开关2（拨码/乒乓开关，SW1 = C8、SW2 = C7）----------
#  ★★★ 2026-10-15【参数菜单·第1步】这两个是**本步新接**的（原来没约束、RTL 也没端口）：
#    · **SW2（C7）**：每拨动一次 ⇒ 菜单 开 / 关 **翻转**
#    · **SW1（C8）**：菜单打开时 = 光标 **上 / 下移**（方向由"变化那一拍的电平"定符号）
#  来源（三处，互为印证 —— 和下面 SW3/SW4 同一组、同一份资料）：
#    · 《HX4S20 开发板手册》p.18 图 2-19：**SW1=C8** / **SW2=C7** / SW3=C6 / SW4=C5
#    · 原理图网名 `NLSWKEY01` = **C8**、`NLSWKEY02` = **C7**（SW3 是 `NLSWKEY03` = C6，同一族）
#    · 官方 DEMO 约束里 `key[0]`/`key[1]`（`SW[0]`/`SW[1]`）= **C8**/**C7**，且都写 PULLTYPE = PULLUP
#  ★ 必须 PULLUP：开关"1"那一侧是**开路**的（只有另一侧接地），
#    内部不上拉就会悬空、读数乱跳（和上面三个按键 / SW3 / SW4 同理）。
#  ★ 极性：RTL 里 SW2/SW1 都用 `sw_edge_debounce` 的"任意方向变化出一拍脉冲"，
#    SW2 只认"变化"（不看方向）；SW1 用**变化那一拍的电平**定上下 —— 那个极性在
#    `top_m2.v` 里是一行 localparam（`MENU_UP_ON_1`），上板反了就改那一个 bit。
set_pin_assignment	{ sw1 }	{ LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ sw2 }	{ LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- 开关3（拨码/乒乓开关，SW3 = C6）：★ 音频切换（每拨一次 → 下一条 .WAV）----------
#   来源（三处，互为印证）：
#     · 《HX4S20 开发板手册》p.18 图 2-19：SW1=C8 / SW2=C7 / **SW3=C6** / SW4=C5
#     · 原理图网名 `NLSWKEY03` = **C6**
#     · 官方 DEMO 约束里 `key[2]`（`SW[2]`）= **C6**，且都写 PULLTYPE = PULLUP
#   ★ 必须 PULLUP：开关"1"那一侧是**开路**的（只有另一侧接地），
#     内部不上拉就会悬空、读数乱跳（和上面三个按键同理）。
#   ★ 极性两份官方文档矛盾 ⇒ RTL 里用 `sw_edge_debounce` 双边沿，不依赖方向。
set_pin_assignment	{ sw3 }	{ LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- 开关4（拨码/乒乓开关，SW4 = C5）：★ 字幕水平滚动（拨到某一侧 = 滚动）----------
#   来源（与上面 SW3 同一组，三处互印证）：
#     · 《HX4S20 开发板手册》p.18 图 2-19：SW1=C8 / SW2=C7 / SW3=C6 / **SW4=C5**
#     · 原理图网名 `NLSWKEY04` = **C5**（SW3 是 `NLSWKEY03` = C6，同一族）
#     · 官方 DEMO 约束里 `key[3]`（`SW[3]`）= **C5**，且写 PULLTYPE = PULLUP
#   ★ 必须 PULLUP：开关"1"那一侧是**开路**的（只有另一侧接地），不内部上拉就会悬空、读数乱跳。
#   ★ 极性两份官方文档矛盾 ⇒ RTL 里按【电平】用（不是边沿/脉冲），不依赖"哪边是 1"的文档：
#       拨到上拉/开路侧（丝印 1）= 读 1 = 滚动；拨到接地侧（丝印 0）= 读 0 = 静止。
#       万一板子方向和手册相反：把 top_m2 里送给 disp_top 的 `sw4_p2` 取反一处即可。
#   ★ 排查入口：万一拨 SW4 完全没反应，先确认串口/LED 正常、再核对手册 p.18 图 2-19 与
#     原理图网名 NLSWKEY04 是否确为 C5（本工程 SW3=C6 已上板验证过，同一组开关可信度高）。
set_pin_assignment	{ sw4 }	{ LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- SD 卡（SPI，A 轨在用）----------
#   ★ 卡座是 3.3V 供电的，直接用 LVCMOS33；MISO 上拉（卡不在时不要悬空）
set_pin_assignment	{ sd_ncs }	{ LOCATION = A12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ sd_dclk }	{ LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ sd_mosi }	{ LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ sd_miso }	{ LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---------- 4 个 LED（高电平点亮）----------
#   led0 : 两个 PLL 都锁了       led1 : SD 卡初始化完成
#   led2 : 至少装载完成过一张     led3 : A 报错（亮 = 出问题）
set_pin_assignment	{ led[0] }	{ LOCATION = A4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[1] }	{ LOCATION = A3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[2] }	{ LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[3] }	{ LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---------- 6 位数码管 ----------
#   显示 A 的 dbg_wr_cnt（正常 03A980）。★ M0 时这一路不亮，所以以串口为准
set_pin_assignment	{ seg_data[0] }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[1] }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[2] }	{ LOCATION = B6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[3] }	{ LOCATION = A5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[4] }	{ LOCATION = B5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[5] }	{ LOCATION = A8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[6] }	{ LOCATION = A7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[7] }	{ LOCATION = A6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment	{ seg_sel[0] }	{ LOCATION = E12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[1] }	{ LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[2] }	{ LOCATION = C13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[3] }	{ LOCATION = F10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[4] }	{ LOCATION = E11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[5] }	{ LOCATION = D11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---------- 串口（板载 CH340，只发不收）----------
#   ★ 今晚的主要调试手段：115200 8N1，每 0.5 秒一行
set_pin_assignment	{ uart_tx }	{ LOCATION = D12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---------- HDMI（差分只约束 _P，负端由工具自动配对）----------
set_pin_assignment	{ HDMI_CLK_P }	{ LOCATION = C3; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D0_P }	{ LOCATION = G5; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D1_P }	{ LOCATION = F1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
set_pin_assignment	{ HDMI_D2_P }	{ LOCATION = E1; IOSTANDARD = LVDS33; PULLTYPE = NONE; }
# DDC 两条线都要上拉（I2C 读显示器 EDID）
set_pin_assignment	{ HDMI_DDC_SCL }	{ LOCATION = P2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ HDMI_DDC_SDA }	{ LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# ---------- 备查：本工程用不到的其它外设引脚 ----------
#   串口接收：uart_rx = F12
#   蜂鸣器：spk = H11
#   音频（WM8731）：aud_bclk=F15  aud_xck=E15  aud_daclrck=J16  aud_dacdat=G14
#   ★ 片内 SDRAM 是 SIP 封装的，没有引脚、不需要约束。
